<!-- Vue 可选支持：仅当 org.jetbrains.plugins.vue 存在时加载。
     将 Vue 专属的 foldingBuilder 注册从主 plugin.xml 移入此处，
     使得纯 React / Solid 用户无需安装 Vue 插件。 -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Vue 模板注入 JS 的 folding（mustache {{ $t('x') }} 等） -->
        <lang.foldingBuilder
                language="VueJS"
                implementationClass="com.pan.extractor.ui.I18nFoldingBuilder"/>
        <!-- Vue 宿主语言必须注册「复合」builder：
             平台 forLanguage(Vue) 沿 Vue→HTML→XML 链只取首个注册语言的 builder，
             直接注册 I18nFoldingBuilder 会遮蔽 XML 的 XmlFoldingBuilder，
             导致 template 内 div 等结构折叠全部失效。复合 builder 先委托原生
             结构折叠、再追加 t() 翻译折叠，两类折叠共存。 -->
        <lang.foldingBuilder
                language="Vue"
                implementationClass="com.pan.extractor.ui.VueHostFoldingBuilder"/>
    </extensions>
</idea-plugin>
