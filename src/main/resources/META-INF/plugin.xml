<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.pan.vue-i18n-extractor</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-name -->
    <name>I18n-Extractor</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/robertpanvip/i18n-extractor">pan</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/plugin-overview-page.html#plugin-description -->
    <description><![CDATA[
Multi-framework i18n Extractor

This plugin helps developers quickly internationalize hard-coded strings in JavaScript/TypeScript projects:

- **Multi-framework**: auto-detects Vue (vue-i18n), React (react-i18next / react-intl), Angular (ngx-translate), Solid (solid-i18n) and Svelte (svelte-i18n), producing the correct i18n call syntax
- **Multi-language**: extracts Chinese, Japanese, Korean, English, French, Russian, German, Spanish, Italian and Portuguese — target languages are configurable in Settings
- Scans template text nodes, attributes, TS/JS string literals, concatenations and template literals (including Vue single-file components)
- Context-aware extraction based on a string's role in the syntax tree, not just raw characters
- Auto-injects `import` statements and hook declarations (`useI18n` for Vue / `useTranslation` for React)
- Supports both single-file extraction and project-wide batch extraction
- Suggests merging similar strings via common prefix/suffix and digit-placeholder grouping
- All changes wrapped in `WriteCommandAction` — fully supports undo (Ctrl+Z)
]]></description>
    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>JavaScript</depends>
    <!-- Vue 插件设为可选依赖：纯 React / Solid 用户无需安装 Vue 插件即可使用本插件。
         当 Vue 插件存在时，.vue SFC 的注入语言 / 模板解析能力自动激活。 -->
    <depends optional="true" config-file="vue-support.xml">org.jetbrains.plugins.vue</depends>
    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup
                id="Vue i18n 提取提示"
                displayType="BALLOON"
                toolWindowId="Project"
                isLogByDefault="false"
        />
        <applicationService serviceImplementation="com.pan.extractor.ui.I18nSettings"/>
        <applicationConfigurable
                id="com.pan.extractor.settings"
                displayName="I18n Extractor"
                instance="com.pan.extractor.ui.I18nSettingsConfigurable"/>
        <lang.foldingBuilder
                language="JavaScript"
                implementationClass="com.pan.extractor.ui.I18nFoldingBuilder"/>
        <lang.foldingBuilder
                language="TypeScript"
                implementationClass="com.pan.extractor.ui.I18nFoldingBuilder"/>
        <!-- .tsx 文件的实际语言 ID 是 "TypeScript JSX"（TypeScript 的 dialect），
             需单独注册，否则 .tsx 中的 $t()/t() 不会触发展开/折叠。 -->
        <lang.foldingBuilder
                language="TypeScript JSX"
                implementationClass="com.pan.extractor.ui.I18nFoldingBuilder"/>
        <!-- .jsx 文件的实际语言 ID；不同版本可能是 "JSX Harmony" 或 "JSX"，此处同时注册。 -->
        <lang.foldingBuilder
                language="JSX Harmony"
                implementationClass="com.pan.extractor.ui.I18nFoldingBuilder"/>
        <lang.foldingBuilder
                language="JSX"
                implementationClass="com.pan.extractor.ui.I18nFoldingBuilder"/>
        <!-- Vue 语言的 foldingBuilder 移至 vue-support.xml（可选依赖） -->
        <editorFactoryListener
                implementation="com.pan.extractor.ui.I18nFoldToggleInlayProvider"/>
        <!-- 切 tab 时才处理该编辑器的 inlay（避免项目恢复时一次性处理所有历史 tab） -->
        <fileEditorManagerListener
                implementation="com.pan.extractor.ui.I18nFoldToggleInlayProvider"/>
    </extensions>
    <actions>
        <!-- Refactor 菜单下的批量转换 -->
        <action id="com.pan.extractor.AllI18nExtractorAction"
                class="com.pan.extractor.action.AllI18nExtractorAction"
                text="项目中文国际提取"
                description="提取 vue react文件中的中文，替换为 $t()"
                icon="/icon.svg">
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </action>
        <action
                id="I18nExtractorAction"
                class="com.pan.extractor.action.I18nExtractorAction"
                text="中文国际化提取"
                description="提取 Vue React文件中的中文，替换为 $t() 并生成 JSON"
                icon="/icon.svg"
        >
            <add-to-group
                    group-id="EditorPopupMenu"
                    anchor="first"
            />
            <add-to-group
                    group-id="ProjectViewPopupMenu"
                    anchor="first"
            />
        </action>
    </actions>
</idea-plugin>
